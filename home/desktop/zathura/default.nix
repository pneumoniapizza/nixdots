{...}: {
  programs.zathura = {
    enable = true;

    options = {
      font = "MonaspiceNe Nerd Font 10";
      guioptions = "s"; # statusbar only, no scrollbars or inputbar clutter
      selection-clipboard = "clipboard";
      adjust-open = "best-fit";
      pages-per-row = 1;
      scroll-page-aware = true;
      statusbar-home-tilde = true;
      window-title-home-tilde = true;

      # recolor pages with the matugen palette (toggle with Ctrl+R)
      recolor = true;
      recolor-keephue = true;
      highlight-transparency = 0.4;
    };

    # colors are generated by matugen into ~/.config/zathura/colors
    extraConfig = ''
      include colors
    '';
  };
}
