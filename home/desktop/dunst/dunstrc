[global]
# --- behaviour ---
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current
dmenu = fuzzel --dmenu
browser = xdg-open
always_run_script = true
sticky_history = yes
history_length = 50
stack_duplicates = true
hide_duplicate_count = false

# --- geometry (notifications go top-right, under the bar) ---
origin = top-right
offset = (20, 20)
width = 400
notification_limit = 5
gap_size = 12
padding = 16
horizontal_padding = 20
frame_width = 2
corner_radius = 12
progress_bar_corner_radius = 12
icon_corner_radius = 8
frame_color = "#403d52"
separator_color = frame
highlight = "#c4a7e7"

# --- text & icons ---
font = JetBrainsMono Nerd Font 10
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
ellipsize = end
show_age_threshold = 60
show_indicators = no
icon_position = left
min_icon_size = 32
max_icon_size = 48
icon_theme = "Papirus-Dark"
enable_recursive_icon_lookup = true

[urgency_low]
background = "#191724"
foreground = "#e0def4"
timeout = 3

[urgency_normal]
background = "#191724"
foreground = "#e0def4"
timeout = 5

[urgency_critical]
background = "#543043"
foreground = "#eb6f92"
frame_color = "#eb6f92"
timeout = 0
